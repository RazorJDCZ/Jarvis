{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.venv/**": true,
    "**/.data/**": true,
    "**/.tools/**": true,
    "**/models/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/build/**": true,
    "**/desktop/src-tauri/target/**": true,
    "**/mobile/android/.gradle/**": true,
    "**/mobile/android/app/build/**": true
  },
  "search.exclude": {
    "**/.venv/**": true,
    "**/.data/**": true,
    "**/.tools/**": true,
    "**/models/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/build/**": true,
    "**/desktop/src-tauri/target/**": true,
    "**/mobile/android/.gradle/**": true,
    "**/mobile/android/app/build/**": true
  },
  "files.exclude": {
    "**/.venv": true,
    "**/.data": true,
    "**/.tools": true,
    "**/models": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/build": true,
    "**/desktop/src-tauri/target": true,
    "**/mobile/android/.gradle": true,
    "**/mobile/android/app/build": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.analysis.exclude": [
    "**/.venv/**",
    "**/.data/**",
    "**/.tools/**",
    "**/models/**",
    "**/desktop/src-tauri/target/**",
    "**/mobile/android/.gradle/**",
    "**/mobile/android/app/build/**"
  ],
  "java.server.launchMode": "LightWeight",
  "java.import.gradle.enabled": false,
  "java.gradle.buildServer.enabled": "off",
  "java.autobuild.enabled": false,
  "java.import.exclusions": [
    "**/.venv/**",
    "**/.data/**",
    "**/.tools/**",
    "**/models/**",
    "**/desktop/src-tauri/target/**",
    "**/mobile/android/.gradle/**",
    "**/mobile/android/app/build/**"
  ],
  "java.project.resourceFilters": [
    "node_modules",
    "\\.git",
    "\\.venv",
    "\\.data",
    "\\.tools",
    "models",
    "target",
    "build",
    "\\.gradle"
  ],
  "gradle.autoDetect": "off"
}
