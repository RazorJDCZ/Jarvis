# Server (always loopback-only; Tailscale Serve acts as the private HTTPS proxy)
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Private mobile access. scripts/setup_remote_access.ps1 fills origin/login after Tailscale pairing.
JARVIS_REMOTE_ACCESS_ENABLED=false
JARVIS_REMOTE_ORIGIN=
JARVIS_REMOTE_ALLOWED_LOGIN=
JARVIS_REMOTE_DATABASE=.data/remote-access.sqlite3
JARVIS_REMOTE_PAIRING_SECONDS=300
JARVIS_REMOTE_SESSION_HOURS=12

# Reasoning through the signed-in ChatGPT account (no API key).
# Install/open Codex once and run `codex login` if setup reports no active session.
JARVIS_BRAIN_MODE=codex
JARVIS_CODEX_COMMAND=codex
JARVIS_CODEX_MODEL=gpt-5.6-luna
JARVIS_CODEX_DEEP_MODEL=gpt-5.6-luna
JARVIS_CODEX_EFFORT=high
JARVIS_CODEX_DEEP_EFFORT=high
JARVIS_CODEX_ACTION_EFFORT=high
JARVIS_CODEX_TIMEOUT=240
JARVIS_CODEX_CODING_TIMEOUT=900
JARVIS_CODEX_CODING_PERMISSIONS=jarvis-project-only
JARVIS_CODEX_STARTUP_TIMEOUT=20
JARVIS_CODEX_MAX_PARALLEL=3

# Ollama is optional and is used only by the local semantic embedding index.
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_KEEP_ALIVE=0s
JARVIS_OLLAMA_WARMUP_ENABLED=false
JARVIS_OLLAMA_WARMUP_MIN_FREE_GB=6

# Speech-to-text
JARVIS_STT_MODEL=small
JARVIS_STT_DEVICE=auto
JARVIS_STT_COMPUTE_TYPE=int8
JARVIS_STT_LANGUAGE=es

# Voice and behavior
JARVIS_WAKE_WORD=jarvis
JARVIS_WAKE_WINDOW_SECONDS=10
JARVIS_KOKORO_MODEL=models/kokoro/kokoro-v1.0.onnx
JARVIS_KOKORO_VOICES=models/kokoro/voices-v1.0.bin
JARVIS_KOKORO_VOICE=am_onyx
JARVIS_KOKORO_SPEED=1.20
JARVIS_PIPER_MODEL=models/piper/es_ES-sharvard-medium.onnx
JARVIS_MAX_HISTORY_MESSAGES=16
JARVIS_MAX_SESSIONS=64
JARVIS_SAFE_ACTIONS_ENABLED=true
JARVIS_ACTION_MODEL_PLANNING=true
JARVIS_AGENT_REASONING_ENABLED=true
JARVIS_AGENT_NATIVE_TOOLS=true
JARVIS_AGENT_TOOL_LIMIT=18
JARVIS_AGENT_KEEP_ALIVE=0s
JARVIS_AGENT_TIMEOUT=60
JARVIS_AGENT_MAX_STEPS=6
JARVIS_AGENT_MAX_ROUNDS=4
JARVIS_AGENT_MIN_CONFIDENCE=0.72
JARVIS_DEEP_ANALYSIS_CONFIRMATION_ENABLED=true
JARVIS_DEEP_ANALYSIS_CONFIRMATION_SECONDS=180
JARVIS_ACTION_CONFIRMATION_SECONDS=90
JARVIS_VISION_ACTIONS_ENABLED=true
JARVIS_VISION_TIMEOUT=180
JARVIS_VISION_KEEP_ALIVE=2m
JARVIS_VISION_RELEASE_AFTER_USE=true
JARVIS_BROWSER_SEARCH_URL=https://www.google.com/search?q={query}
JARVIS_BROWSER_PERSONAL_PROFILE=true
JARVIS_INFORMATION_VERIFICATION_ENABLED=true
JARVIS_INFORMATION_TIMEOUT=8
JARVIS_USER_PROFILE=.data/user_profile.json
JARVIS_MEMORY_ENABLED=true
JARVIS_MEMORY_PATH=.data/memory.sqlite3
JARVIS_MEMORY_MAX_ENTRIES=500
JARVIS_MEMORY_MAX_TURNS=60
JARVIS_MEMORY_RETENTION_DAYS=30
JARVIS_MEMORY_CONTEXT_ITEMS=8

# Local capability deck (all persistent data remains under .data by default)
JARVIS_CAPABILITIES_ENABLED=true
JARVIS_CAPABILITY_DATABASE=.data/capabilities.sqlite3
JARVIS_ATTACHMENT_MAX_BYTES=12582912
JARVIS_ATTACHMENT_RETENTION_HOURS=24
JARVIS_SCHEDULER_POLL_SECONDS=2
JARVIS_SYSTEM_MONITOR_SECONDS=15

# Appa integration. By default Jarvis discovers Appa's private loopback bridge dynamically.
# Keep Appa running or hidden in its tray; no cloud account or paid API is used.
# Optional override used by the supervisor; otherwise it discovers Appa Jarvis.exe
# on the Desktop or the sibling appa release build.
JARVIS_APPA_EXECUTABLE=
JARVIS_APPA_AUTO_DISCOVER=true
JARVIS_APPA_BRIDGE_CONFIG=
# Manual REST override for development only. HTTPS or loopback HTTP only.
JARVIS_APPA_URL=
JARVIS_APPA_TOKEN=
JARVIS_APPA_TIMEOUT=8

# Extra development roots are semicolon-separated. Jarvis itself is always the default root.
# Example on Windows: D:\Verano_2026
JARVIS_WORKSPACE_ROOTS=
# Optional manifest roots, separated with semicolons. Empty uses the standard locations,
# but they are inspected only after an explicit game-library request.
JARVIS_STEAM_ROOTS=
JARVIS_EPIC_MANIFEST_ROOTS=
JARVIS_PIPER_SPEAKER_ID=0
JARVIS_PIPER_LENGTH_SCALE=1.06
JARVIS_PIPER_NOISE_SCALE=0.60
JARVIS_PIPER_NOISE_W_SCALE=0.70
JARVIS_PIPER_VOLUME=0.96

# Adaptive everyday assistant. Keep a reserve for Windows, browsers and games.
JARVIS_ADAPTIVE_RESOURCES=true
JARVIS_MODEL_RESERVE_GB=2.5
JARVIS_REASONING_MIN_FREE_GB=8.0
JARVIS_STT_CPU_THREADS=4
JARVIS_VOICE_PRELOAD=true
# Install locally with: .tools\ollama\ollama.exe pull embeddinggemma
JARVIS_SEMANTIC_ENABLED=true
