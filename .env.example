# Server (always loopback-only; Tailscale Serve acts as the private HTTPS proxy)
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Private mobile access. scripts/setup_remote_access.ps1 fills origin/login after Tailscale pairing.
JARVIS_REMOTE_ACCESS_ENABLED=false
JARVIS_REMOTE_ORIGIN=
JARVIS_REMOTE_ALLOWED_LOGIN=
JARVIS_REMOTE_DATABASE=.data/remote-access.sqlite3
JARVIS_REMOTE_PAIRING_SECONDS=300
JARVIS_REMOTE_SESSION_HOURS=12

# Local conversational model
JARVIS_BRAIN_MODE=auto
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen3.5:4b
JARVIS_OLLAMA_TIMEOUT=180
JARVIS_OLLAMA_KEEP_ALIVE=0s
JARVIS_OLLAMA_WARMUP_ENABLED=false
JARVIS_OLLAMA_WARMUP_MIN_FREE_GB=6

# Speech-to-text
JARVIS_STT_MODEL=small
JARVIS_STT_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8
JARVIS_STT_LANGUAGE=es

# Voice and behavior
JARVIS_WAKE_WORD=jarvis
JARVIS_WAKE_WINDOW_SECONDS=10
JARVIS_KOKORO_MODEL=models/kokoro/kokoro-v1.0.onnx
JARVIS_KOKORO_VOICES=models/kokoro/voices-v1.0.bin
JARVIS_KOKORO_VOICE=em_alex
JARVIS_KOKORO_SPEED=0.96
JARVIS_PIPER_MODEL=models/piper/es_ES-sharvard-medium.onnx
JARVIS_MAX_HISTORY_MESSAGES=16
JARVIS_MAX_SESSIONS=64
JARVIS_SAFE_ACTIONS_ENABLED=true
JARVIS_ACTION_MODEL_PLANNING=true
JARVIS_ACTION_CONFIRMATION_SECONDS=90
JARVIS_VISION_ACTIONS_ENABLED=true
JARVIS_VISION_TIMEOUT=180
JARVIS_VISION_KEEP_ALIVE=2m
JARVIS_VISION_RELEASE_AFTER_USE=true
JARVIS_BROWSER_SEARCH_URL=https://www.google.com/search?q={query}
JARVIS_BROWSER_PERSONAL_PROFILE=true
JARVIS_INFORMATION_VERIFICATION_ENABLED=true
JARVIS_INFORMATION_TIMEOUT=8
JARVIS_USER_PROFILE=.data/user_profile.json
JARVIS_MEMORY_ENABLED=true
JARVIS_MEMORY_PATH=.data/memory.sqlite3
JARVIS_MEMORY_MAX_ENTRIES=500
JARVIS_MEMORY_MAX_TURNS=60
JARVIS_MEMORY_RETENTION_DAYS=30
JARVIS_MEMORY_CONTEXT_ITEMS=8
JARVIS_PIPER_SPEAKER_ID=0
JARVIS_PIPER_LENGTH_SCALE=1.06
JARVIS_PIPER_NOISE_SCALE=0.60
JARVIS_PIPER_NOISE_W_SCALE=0.70
JARVIS_PIPER_VOLUME=0.96
